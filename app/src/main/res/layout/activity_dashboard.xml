<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".DashboardActivity">

    <!-- Header (RelativeLayout) -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:background="#1E3A5F"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Profile Icon -->
        <ImageView
            android:id="@+id/imgProfil"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#FFFFFF" />

        <!-- Header Text Container (LinearLayout) -->
        <LinearLayout
            android:id="@+id/layoutHeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/imgProfil"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Présence Manager"
                android:textColor="#FF9800"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tableau de bord"
                android:textColor="#CBD5E1"
                android:textSize="15sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Welcome Message -->
    <TextView
        android:id="@+id/txtBienvenue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Bienvenue, Formateur"
        android:textColor="#1E3A5F"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Instruction -->
    <TextView
        android:id="@+id/txtInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Choisissez une fonctionnalité"
        android:textColor="#647488"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/txtBienvenue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- GridLayout for Features -->
    <GridLayout
        android:id="@+id/gridFonctionnalites"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintTop_toBottomOf="@id/txtInstruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Card 1: Groupes -->
        <LinearLayout
            android:id="@+id/cardGroupes"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="#E0E7FF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#1E3A5F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Groupes"
                android:textColor="#1E3A5F"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 2: Faire l'appel (With Badge) -->
        <LinearLayout
            android:id="@+id/cardAppel"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="#DBEAFE"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- FrameLayout for Icon + Badge -->
            <FrameLayout
                android:id="@+id/frameAppel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_my_calendar"
                    app:tint="#1E3A5F" />

                <!-- Badge (CardView) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    app:cardBackgroundColor="#DC2626"
                    app:cardCornerRadius="11dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/txtBadge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Faire l'appel"
                android:textColor="#1E3A5F"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 3: Historique -->
        <LinearLayout
            android:id="@+id/cardHistorique"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="#D1FAE5"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="#1E3A5F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Historique"
                android:textColor="#1E3A5F"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 4: Statistiques -->
        <LinearLayout
            android:id="@+id/cardStatistiques"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:background="#FEF3C7"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#1E3A5F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Statistiques"
                android:textColor="#1E3A5F"
                android:textStyle="bold" />
        </LinearLayout>

    </GridLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/txtFooterDashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="PrésenceManager - Version 1.0"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
